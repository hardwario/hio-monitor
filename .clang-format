# HARDWARIO Monitor v2 code style (ADR-0023, plan/features/0001-m0-skeleton.md).
# Reference version: clang-format 21 (ADR-0021).
---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
AccessModifierOffset: -4
InsertBraces: true
IncludeBlocks: Regroup
# Order: own headers -> Qt -> other third-party -> std.
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<Q[A-Za-z0-9]*(/[A-Za-z0-9_.]+)?>$'
    Priority: 2
  - Regex: '^<(CLI|gtest|gmock)/'
    Priority: 3
  - Regex: '^<'
    Priority: 4
...
