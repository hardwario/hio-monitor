#!/bin/sh
# hardwario-monitor postinst (plan/features/0015 C2, ADR-0072): load the J-Link udev rule
# (/usr/lib/udev/rules.d/60-hardwario-jlink.rules) and apply it to connected probes. Errors are
# ignored (e.g. no udev inside containers).
set -e
if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=1366 >/dev/null 2>&1 || true
fi
exit 0
