# HARDWARIO Monitor (ADR-0072, ADR-0121, ADR-0185): SEGGER J-Link probes (USB vendor 1366) are
# accessible to the user of the local seat (systemd-logind ACL), not to every account. Installed by
# the hardwario-monitor .deb; the same rule is shown by the setup wizard for other installations.
SUBSYSTEM=="usb", ATTR{idVendor}=="1366", TAG+="uaccess"
