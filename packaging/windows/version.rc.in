// Windows resources of @HWIO_RC_ORIGINAL_FILENAME@ (plan/features/0015 A3): the application icon
// (the v1 icon, packaging/common/icons/hwio-monitor.ico) and VERSIONINFO. Configured by CMake.
#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/packaging/common/icons/hwio-monitor.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "HARDWARIO a.s."
            VALUE "FileDescription", "@HWIO_RC_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@HWIO_VERSION_NUMERIC@.0"
            VALUE "InternalName", "@HWIO_RC_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) HARDWARIO a.s."
            VALUE "OriginalFilename", "@HWIO_RC_ORIGINAL_FILENAME@"
            VALUE "ProductName", "HARDWARIO Monitor"
            VALUE "ProductVersion", "@HWIO_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
