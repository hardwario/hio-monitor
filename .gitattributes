# Git LFS - every binary file (and generated text > 100 KB, e.g. firmware .hex) MUST be tracked here (CLAUDE.md, ADR-0112)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# HTTP fuzz seeds: raw requests with CRLF line ends, stored byte for byte (ADR-0152)
libs/mcp/fuzz/corpus/http_parser_fuzz/* -text

# Git LFS - every binary / large file MUST be tracked here (see CLAUDE.md)
# Native libraries and executables (vendor SDKs like J-Link/nrfjprog must NOT be committed at all)
*.so filter=lfs diff=lfs merge=lfs -text
*.so.* filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
# Firmware images and archives
*.hex filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.elf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# Wizard illustrations (ADR-0076): the whole slot directory, SVG included (README.md stays text)
app/gui/assets/wizard/*.svg filter=lfs diff=lfs merge=lfs -text
# Images, video, documents (wizard illustrations etc.)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.icns filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
