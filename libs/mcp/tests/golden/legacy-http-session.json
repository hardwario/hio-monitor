            "headers": {
                "Mcp-Session-Id": "$session"
            },
            "send": {
                "id": 9,
                "jsonrpc": "2.0",
                "method": "tools/call",
                "params": {
                    "arguments": {
                        "text": "x"
                    },
                    "name": "echo"
