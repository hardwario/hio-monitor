            "send": {
                "id": 8,
                "jsonrpc": "2.0",
                "method": "initialize",
                "params": {
                    "capabilities": {
                    },
                    "clientInfo": {
                        "name": "golden",
                        "version": "1"
                    },
                    "protocolVersion": "2025-11-25"
                }
            },
            "status": "bad_request",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "id": 9,
                    "jsonrpc": "2.0",
                    "result": {
                        "content": [
                            {
                                "text": "{\"count\":1,\"text\":\"x\"}",
                                "type": "text"
