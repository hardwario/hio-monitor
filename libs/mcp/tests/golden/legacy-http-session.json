{
    "description": "Legacy over HTTP: Mcp-Session-Id minted by initialize, required afterwards, unknown -> 404, forbidden on modern requests, version header checked, DELETE ends the session.",
    "steps": [
        {
            "capture": true,
            "expect": [
                {
                    "id": 1,
                    "jsonrpc": "2.0",
                    "result": {
                        "capabilities": {
                            "prompts": {
                            },
                            "resources": {
                                "listChanged": true,
                                "subscribe": true
                            },
                            "tools": {
                            }
                        },
                        "protocolVersion": "2025-11-25",
                        "serverInfo": {
                            "name": "hio-monitor",
                            "version": "test"
                        }
                    }
                }
            ],
            "send": {
                "id": 1,
                "jsonrpc": "2.0",
                "method": "initialize",
                "params": {
                    "capabilities": {
                    },
                    "clientInfo": {
                        "name": "golden",
                        "version": "1"
                    },
                    "protocolVersion": "2025-11-25"
                }
            },
            "status": "ok",
            "transport": "http"
        },
        {
            "expect": [
            ],
            "headers": {
                "MCP-Protocol-Version": "2025-11-25",
                "Mcp-Session-Id": "$session"
            },
            "send": {
                "jsonrpc": "2.0",
                "method": "notifications/initialized"
            },
            "status": "accepted",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
                        "message": "Missing Mcp-Session-Id (send initialize first, or use 2026-07-28 with _meta)"
                    },
                    "id": 2,
                    "jsonrpc": "2.0"
                }
            ],
            "send": {
                "id": 2,
                "jsonrpc": "2.0",
                "method": "tools/list"
            },
            "status": "bad_request",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
                        "message": "Missing Mcp-Session-Id (send initialize first, or use 2026-07-28 with _meta)"
                    },
                    "jsonrpc": "2.0"
                }
            ],
            "send": {
                "jsonrpc": "2.0",
                "method": "notifications/initialized"
            },
            "status": "bad_request",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "id": 3,
                    "jsonrpc": "2.0",
                    "result": {
                    }
                }
            ],
            "headers": {
                "MCP-Protocol-Version": "2025-11-25",
                "Mcp-Session-Id": "$session"
