            "send": {
                "id": 3,
                "jsonrpc": "2.0",
                "method": "ping"
            },
            "status": "ok",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "id": 4,
                    "jsonrpc": "2.0",
                    "result": {
                    }
                }
            ],
            "headers": {
                "Mcp-Session-Id": "$session"
            },
            "send": {
                "id": 4,
                "jsonrpc": "2.0",
                "method": "ping"
            },
            "status": "ok",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
                        "message": "MCP-Protocol-Version does not match the negotiated version"
                    },
                    "id": 5,
                    "jsonrpc": "2.0"
                }
            ],
            "headers": {
                "MCP-Protocol-Version": "2025-06-18",
                "Mcp-Session-Id": "$session"
