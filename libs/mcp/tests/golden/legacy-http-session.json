            "send": {
                "id": 5,
                "jsonrpc": "2.0",
                "method": "ping"
            },
            "status": "bad_request",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
                        "message": "Unknown or expired session"
                    },
                    "id": 6,
                    "jsonrpc": "2.0"
                }
            ],
            "headers": {
                "Mcp-Session-Id": "bogus"
            },
            "send": {
                "id": 6,
                "jsonrpc": "2.0",
                "method": "ping"
            },
            "status": "not_found",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
