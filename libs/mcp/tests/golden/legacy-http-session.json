            "status": "ok",
            "transport": "http"
        },
        {
            "action": "get",
            "expect": [
            ],
            "headers": {
            },
            "status": "bad_request",
            "transport": "http"
        },
        {
            "action": "get",
            "expect": [
            ],
            "headers": {
                "Mcp-Session-Id": "bogus"
            },
            "status": "not_found",
            "transport": "http"
        },
        {
            "action": "delete",
            "expect": [
            ],
            "headers": {
                "Mcp-Session-Id": "$session"
            },
            "status": "ok",
            "transport": "http"
        },
        {
            "expect": [
                {
                    "error": {
                        "code": -32600,
                        "message": "Unknown or expired session"
                    },
                    "id": 10,
                    "jsonrpc": "2.0"
                }
            ],
            "headers": {
                "Mcp-Session-Id": "$session"
            },
            "send": {
                "id": 10,
                "jsonrpc": "2.0",
                "method": "ping"
            },
            "status": "not_found",
            "transport": "http"
